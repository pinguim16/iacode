"""Opt out of external crash/telemetry bootstrap only; retain every native check and bound."""

from __future__ import annotations

import contextlib
import importlib.util
import io
import json
import sys
from pathlib import Path

OWNER = Path(__file__).resolve().parent
spec = importlib.util.spec_from_file_location("native_kernel_observer", OWNER / "OBSERVE-NATIVE-KERNEL-05.py")
observer = importlib.util.module_from_spec(spec)
spec.loader.exec_module(observer)
base = observer.base
original_run = base.native_editor.run_owned
CALLS = []


def private_bootstrap(arguments, *, environment, timeout, as_node=False):
    if not as_node:
        arguments = [*arguments, "--disable-crash-reporter", "--disable-telemetry"]
        CALLS.append({"kind": "REAL_NATIVE_EXTERNAL_CRASH_TELEMETRY_OPT_OUT",
                      "timeoutSeconds": timeout, "extensionAndTrustChecksUnchanged": True})
    return original_run(arguments, environment=environment, timeout=timeout, as_node=as_node)


def main():
    report = base.ROOT / "var/native-crash-optout-experiment-07-v3-32f15cca.json"
    target = OWNER / "NATIVE-CRASH-OPT-OUT-07-TRACE.json"
    if report.exists() or target.exists():
        raise ValueError("never replay an observation")
    base.native_editor.run_owned = private_bootstrap
    base.native_editor.WindowsJob = observer.ObservedJob
    saved = sys.argv
    try:
        sys.argv = ["native_editor.py", "--report", str(report)]
        with contextlib.redirect_stdout(io.StringIO()), contextlib.redirect_stderr(io.StringIO()):
            code = base.native_editor.main()
    finally:
        sys.argv = saved
    producer = base.safe_original(OWNER / "NATIVE-CRASH-OPT-OUT-07-PRODUCER.json", report.read_bytes())
    trace = {"kind": "REAL_NATIVE_CRASH_TELEMETRY_OPT_OUT_EXPERIMENT_NOT_ACCEPTANCE",
             "actualExitCode": code, "calls": CALLS, "jobs": base.TRACES, "producer": producer,
             "totalCleanupDeadlineSeconds": 10, "physicalSignalAndRemovalRequired": True,
             "gateVerdictIssued": False, "independentValidation": False}
    raw = base.safe_original(target, json.dumps(trace, indent=2).encode() + b"\n")
    print(json.dumps({"actualExitCode": code, "trace": raw,
                      "jobs": [{key: value for key, value in row.items() if key != "samples"}
                               for row in base.TRACES]}))
    return code


if __name__ == "__main__":
    raise SystemExit(main())
