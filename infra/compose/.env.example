# IACode Foundation — local environment template.
#
# Copy to `.env` next to this file before starting the stack:
#
#     python scripts/iacode/bootstrap_env.py
#
# `.env` is ignored by Git and is the only place a real credential lives. Every value below is a
# placeholder or a local default: this file is committed, so anything secret written here would be
# published. The bootstrap script generates real local credentials for the three keys marked
# GENERATED and leaves the rest as they are.
#
# Every key here is read by something. A key nothing consumes promises behaviour that does not
# exist, which `.iacode/memory/lessons.jsonl` records as a defect rather than as documentation.

# --------------------------------------------------------------------------------------------
# Identity and profile
# --------------------------------------------------------------------------------------------
# Compose project name. It namespaces every container, volume and network, so this stack cannot
# collide with another Compose project on the same machine.
COMPOSE_PROJECT_NAME=iacode

IACODE_VERSION=0.1.0
IACODE_ENVIRONMENT=local
IACODE_LOG_LEVEL=INFO

# --------------------------------------------------------------------------------------------
# Published ports
# --------------------------------------------------------------------------------------------
# Every port is published on 127.0.0.1 only, and every one is configurable, because a developer
# machine routinely runs more than one stack. The defaults avoid the usual ones (5432, 6379, 9000,
# 7233, 9090, 3000) for exactly that reason.
IACODE_API_PORT=18080
IACODE_WEB_PORT=18081
IACODE_POSTGRES_PORT=15432
IACODE_REDIS_PORT=16379
IACODE_MINIO_API_PORT=19000
IACODE_MINIO_CONSOLE_PORT=19001
IACODE_TEMPORAL_PORT=17233
IACODE_TEMPORAL_UI_PORT=18233
IACODE_PROMETHEUS_PORT=19090
IACODE_GRAFANA_PORT=13000

# --------------------------------------------------------------------------------------------
# PostgreSQL — the system of record
# --------------------------------------------------------------------------------------------
IACODE_POSTGRES_USER=iacode
# GENERATED: replaced with a random local value by bootstrap_env.py.
IACODE_POSTGRES_PASSWORD=change-me-before-starting
IACODE_POSTGRES_DB=iacode

# What the applications connect with. The host is the Compose service name, so this URL is correct
# inside the network regardless of which port the stack publishes.
IACODE_DATABASE_URL=postgresql+asyncpg://iacode:change-me-before-starting@postgres:5432/iacode
IACODE_DATABASE_POOL_SIZE=5
IACODE_DATABASE_MAX_OVERFLOW=5
IACODE_DATABASE_CONNECT_TIMEOUT_SECONDS=5

# --------------------------------------------------------------------------------------------
# Redis — cache
# --------------------------------------------------------------------------------------------
IACODE_REDIS_URL=redis://redis:6379/0

# --------------------------------------------------------------------------------------------
# MinIO — object storage
# --------------------------------------------------------------------------------------------
IACODE_MINIO_ROOT_USER=iacode
# GENERATED: replaced with a random local value by bootstrap_env.py.
IACODE_MINIO_ROOT_PASSWORD=change-me-before-starting
IACODE_MINIO_ENDPOINT=minio:9000
IACODE_MINIO_ACCESS_KEY=iacode
# GENERATED: kept identical to IACODE_MINIO_ROOT_PASSWORD by bootstrap_env.py.
IACODE_MINIO_SECRET_KEY=change-me-before-starting
IACODE_MINIO_SECURE=false
IACODE_MINIO_BUCKET=iacode-artifacts

# --------------------------------------------------------------------------------------------
# Temporal — durable workflows
# --------------------------------------------------------------------------------------------
IACODE_TEMPORAL_TARGET=temporal:7233
IACODE_TEMPORAL_NAMESPACE=default
IACODE_TEMPORAL_TASK_QUEUE=iacode-foundation
# How long the worker keeps retrying its first connection. Temporal's auto-setup provisions its
# schema on first boot, which takes longer than any other service in the stack.
IACODE_WORKER_CONNECT_TIMEOUT_SECONDS=180

# --------------------------------------------------------------------------------------------
# API
# --------------------------------------------------------------------------------------------
# Exact origins only. The configuration refuses '*': a permissive default is how a development
# convenience reaches an environment that is not development.
IACODE_CORS_ALLOW_ORIGINS=http://localhost:18081,http://127.0.0.1:18081
IACODE_CORRELATION_HEADER=X-Correlation-ID
IACODE_READINESS_TIMEOUT_SECONDS=3

# --------------------------------------------------------------------------------------------
# Model Gateway — Gate 1
# --------------------------------------------------------------------------------------------
# Which providers exist is NOT configured here. That is `.iacode/policies/providers.json`, which is
# versioned and carries no value: it names the variables below. What belongs to this machine — the
# address of a provider and the credential to reach it — belongs here, in a file Git ignores.
#
# The gateway discovers the catalog from the provider's own API, so there is no model list to
# maintain. Set the two DevWorld variables, start the stack, and run:
#
#     python scripts/iacode/gateway_smoke.py
#
# Without a credential the gateway reports the provider as unreachable and names the variable that
# is missing. It never falls back to an unauthenticated call.
IACODE_DEVWORLD_BASE_URL=
# Never commit a value here. The file this example produces is ignored by Git; this one is not.
IACODE_DEVWORLD_API_KEY=
# 'provider:model'. Used when a request names neither a model nor a route. Without it such a
# request fails, which is deliberate: choosing one silently would spend tokens on a model nobody
# authorised. Fill it with an identifier the catalog actually contains, after the first sync.
IACODE_GATEWAY_DEFAULT_MODEL=
# 'provider:model' the live smoke check is authorised to spend tokens on. It is checked against the
# discovered catalog and never substituted: an absent smoke model fails the check rather than
# quietly spending on a different, possibly far more expensive, model.
IACODE_GATEWAY_SMOKE_MODEL=
IACODE_GATEWAY_CONNECT_TIMEOUT_SECONDS=5
IACODE_GATEWAY_READ_TIMEOUT_SECONDS=120
# Attempts per candidate, including the first. 1 disables retrying.
IACODE_GATEWAY_MAX_ATTEMPTS=3
# Additional candidates after the first. The fallback chain is bounded by this.
IACODE_GATEWAY_MAX_FALLBACKS=2
IACODE_GATEWAY_MAX_OUTPUT_TOKENS=16384
IACODE_GATEWAY_CIRCUIT_FAILURE_THRESHOLD=5
IACODE_GATEWAY_CIRCUIT_COOLDOWN_SECONDS=30

# --------------------------------------------------------------------------------------------
# Grafana
# --------------------------------------------------------------------------------------------
IACODE_GRAFANA_USER=admin
# GENERATED: replaced with a random local value by bootstrap_env.py.
IACODE_GRAFANA_PASSWORD=change-me-before-starting
