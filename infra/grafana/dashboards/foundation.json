{
  "uid": "iacode-foundation",
  "title": "IACode Foundation",
  "description": "The Gate 0 Foundation at a glance: dependency health, request rate, latency and errors. Deliberately small — every panel answers a question an operator actually asks during an incident.",
  "tags": ["iacode", "foundation"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Dependency health",
      "description": "1 means the dependency answered the API's last readiness probe. This is the same probe /ready uses, so the dashboard and the endpoint cannot disagree.",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "iacode_dependency_up",
          "legendFormat": "{{name}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Build",
      "description": "Which version is running. The first question of every incident.",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "iacode_build_info",
          "legendFormat": "{{service}} {{version}}",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "name"
      },
      "fieldConfig": { "defaults": {}, "overrides": [] }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Requests in flight",
      "description": "Concurrent requests. A number that climbs and never returns means handlers are stuck, not that traffic is high.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(iacode_http_requests_in_flight)",
          "legendFormat": "in flight",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Request rate by route",
      "description": "Requests per second, by route template. The label is the template, never the raw path, so the series count stays bounded.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (path) (rate(iacode_http_requests_total[5m]))",
          "legendFormat": "{{path}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Latency p50 / p95 / p99",
      "description": "Quantiles from the request duration histogram. p99 is what a user notices; a p50 that looks fine while p99 climbs is the usual shape of a dependency going bad.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(iacode_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(iacode_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(iacode_http_request_duration_seconds_bucket[5m])))",
          "legendFormat": "p99"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 1, "fillOpacity": 0 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Responses by status class",
      "description": "Grouped by first digit. A 5xx line that is not flat at zero is the one thing on this dashboard that always needs an explanation.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status) (rate(iacode_http_requests_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Worker task polling",
      "description": "Workflow and activity task rates from the Temporal SDK's own instruments. A worker that is connected but not polling shows here as a flat zero while every other panel looks healthy.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "datasource": { "type": "prometheus", "uid": "iacode-prometheus" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (task_queue) (rate(temporal_workflow_task_execution_latency_count[5m]))",
          "legendFormat": "workflow tasks {{task_queue}}"
        },
        {
          "refId": "B",
          "expr": "sum by (task_queue) (rate(temporal_activity_execution_latency_count[5m]))",
          "legendFormat": "activity tasks {{task_queue}}"
        }
      ],
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "lineWidth": 1, "fillOpacity": 10 } },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true } }
    }
  ]
}
