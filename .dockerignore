# Every Foundation image builds from the repository root, because the applications depend on the
# local packages under packages/. This file keeps the context small: without it Docker uploads the
# whole ledger, every sealed checkpoint and the frontend's node_modules on each build.
.git/
.github/
docs/
prompts/
.claude/
.iacode/
# …except the gateway's provider and route policy, which the API image carries so the runtime reads
# the same declaration the repository holds. Re-including one directory is deliberately narrow: the
# rest of the control plane — the agents, the schemas, the memory, the anchors — has no business
# inside a runtime image.
!.iacode/policies/
tests/
scripts/development-ledger/

__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/

node_modules/
apps/web/dist/
apps/web/.angular/

.env
*.env
!*.env.example

var/
backups/
