{
  "schemaVersion": "1.0.0",
  "policy": "Canonical Quality Engine policy. Profiles select only registered runners. Project configuration may add checks or lower limits, never remove a mandatory check, raise a limit, select execution infrastructure, submit evidence, or author a verdict.",
  "defaults": {
    "maxRunSeconds": 3600,
    "maxCheckSeconds": 1800,
    "maxOutputBytes": 131072
  },
  "profiles": {
    "python": {
      "stacks": ["python"],
      "runners": ["python.build", "python.unit", "python.lint", "python.static", "python.dependency", "common.secret", "common.diff"],
      "optionalRunners": ["python.integration", "python.coverage", "python.migration"],
      "coverageThreshold": null
    },
    "node": {
      "stacks": ["node"],
      "runners": ["node.dependency", "node.build", "node.unit", "node.lint", "common.secret", "common.diff"],
      "optionalRunners": ["node.integration", "node.coverage", "node.migration"],
      "coverageThreshold": null
    },
    "node+typescript": {
      "stacks": ["node", "typescript"],
      "runners": ["node.dependency", "node.build", "node.unit", "node.lint", "typescript.static", "common.secret", "common.diff"],
      "optionalRunners": ["node.integration", "node.coverage", "node.migration"],
      "coverageThreshold": null
    },
    "node+typescript+angular": {
      "stacks": ["node", "typescript", "angular"],
      "runners": ["node.dependency", "angular.build", "angular.unit", "node.lint", "typescript.static", "common.secret", "common.diff"],
      "optionalRunners": ["node.integration", "node.coverage", "node.migration"],
      "coverageThreshold": null
    },
    "python+node+typescript+angular": {
      "stacks": ["python", "node", "typescript", "angular"],
      "runners": ["python.build", "python.unit", "python.lint", "python.static", "python.dependency", "node.dependency", "angular.build", "angular.unit", "node.lint", "typescript.static", "common.secret", "common.diff"],
      "optionalRunners": ["python.integration", "python.coverage", "python.migration", "node.integration", "node.coverage", "node.migration"],
      "coverageThreshold": null
    },
    "maven": {
      "stacks": ["maven"],
      "runners": ["maven.dependency", "maven.build", "maven.unit", "maven.static", "common.secret", "common.diff"],
      "optionalRunners": ["maven.integration", "maven.coverage", "maven.migration"],
      "coverageThreshold": null
    },
    "gradle": {
      "stacks": ["gradle"],
      "runners": ["gradle.dependency", "gradle.build", "gradle.unit", "gradle.static", "common.secret", "common.diff"],
      "optionalRunners": ["gradle.integration", "gradle.coverage", "gradle.migration"],
      "coverageThreshold": null
    }
  }
}
