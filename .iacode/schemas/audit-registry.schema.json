{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/audit-registry.schema.json",
  "title": "Independent audit registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "policy",
    "audits"
  ],
  "$defs": {
    "audit": {
      "type": "object",
      "required": [
        "auditId",
        "milestone",
        "gate",
        "auditor",
        "auditCheckpoint",
        "subjectCheckpoint",
        "subjectCommit",
        "verdict",
        "reviewReport"
      ],
      "properties": {
        "auditId": {
          "type": "string",
          "minLength": 1
        },
        "milestone": {
          "type": "string",
          "pattern": "^M[0-9]+$"
        },
        "gate": {
          "type": "string",
          "minLength": 1
        },
        "auditor": {
          "type": "string",
          "minLength": 1
        },
        "auditCheckpoint": {
          "type": "string",
          "minLength": 1
        },
        "auditCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "subjectCheckpoint": {
          "type": "string",
          "minLength": 1
        },
        "subjectCommit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "verdict": {
          "enum": [
            "APPROVED",
            "REWORK_REQUIRED"
          ]
        },
        "reviewReport": {
          "type": "string",
          "minLength": 1
        },
        "redTeamReport": {
          "type": [
            "string",
            "null"
          ]
        },
        "correctiveCheckpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": [
            "string",
            "null"
          ]
        },
        "findingsClosureFile": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0"
      ]
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "audits": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/audit"
      }
    }
  },
  "additionalProperties": false
}
