{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/provenance.schema.json",
  "title": "Checkpoint provenance manifest",
  "type": "object",
  "required": [
    "schemaVersion",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "2.0.0",
        "3.0.0",
        "3.1.0",
        "3.2.0"
      ]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "sourceType",
          "provider",
          "model",
          "ownership",
          "license",
          "rights",
          "evidence",
          "notes"
        ],
        "properties": {
          "artifact": {
            "type": "string",
            "minLength": 1
          },
          "sourceType": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          },
          "ownership": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "rights": {
            "type": "object",
            "required": [
              "storageAllowed",
              "ragAllowed",
              "trainingAllowed",
              "distillationAllowed"
            ],
            "properties": {
              "storageAllowed": {
                "type": "boolean"
              },
              "ragAllowed": {
                "type": "boolean"
              },
              "trainingAllowed": {
                "type": "boolean",
                "default": false
              },
              "distillationAllowed": {
                "type": "boolean",
                "default": false
              }
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
