{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/mirror-audit.schema.json",
  "title": "Internal milestone mirror audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkpoint",
    "milestone",
    "generatedAt",
    "targetFingerprint",
    "auditorRole",
    "independence",
    "checks",
    "total",
    "passed",
    "failed",
    "result"
  ],
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "expectation",
        "observed",
        "result",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0"
      ]
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "auditorRole": {
      "type": "string",
      "minLength": 1
    },
    "independence": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "notApplicable": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "additionalProperties": false
}
