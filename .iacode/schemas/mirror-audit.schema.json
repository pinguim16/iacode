{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/mirror-audit.schema.json",
  "title": "Internal milestone mirror audit",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkpoint",
    "milestone",
    "generatedAt",
    "targetFingerprint",
    "auditorRole",
    "independence",
    "checks",
    "total",
    "passed",
    "failed",
    "result"
  ],
  "$defs": {
    "check": {
      "type": "object",
      "required": [
        "id",
        "dimension",
        "expectation",
        "observed",
        "result",
        "evidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "expectation": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "NOT_APPLICABLE"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reason": {
          "description": "Why the dimension has nothing to audit. Required when result is NOT_APPLICABLE, and only permitted from schemaVersion 1.1.0.",
          "type": "string",
          "minLength": 1
        },
        "expectedCount": {
          "description": "How many items the canonical derivation found for this dimension. A NOT_APPLICABLE check records 0; a non-zero count is not an inapplicable dimension.",
          "type": "integer",
          "minimum": 0
        },
        "derivationSource": {
          "description": "The canonical source the applicable set was derived from, so an inapplicable dimension can be re-derived rather than believed.",
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ],
      "description": "1.0.0 is the original report. 1.1.0 adds the justification of an inapplicable dimension: reason, expectedCount and derivationSource. A 1.0.0 report has no place to justify a NOT_APPLICABLE check and therefore may not record one; sealed 1.0.0 reports keep the rules they were written for."
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "auditorRole": {
      "type": "string",
      "minLength": 1
    },
    "independence": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/check"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "passed": {
      "type": "integer",
      "minimum": 0
    },
    "failed": {
      "type": "integer",
      "minimum": 0
    },
    "notApplicable": {
      "type": "integer",
      "minimum": 0,
      "description": "Checks whose canonically derived applicable set was empty. They are neither passes nor failures, and the total is passed + failed + notApplicable."
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    }
  },
  "additionalProperties": false
}
