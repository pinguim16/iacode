{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/red-team-report.schema.json",
  "title": "Machine-readable Red Team report",
  "type": "object",
  "required": [
    "schemaVersion",
    "checkpoint",
    "generatedAt",
    "targetFingerprint",
    "source",
    "attacks",
    "total",
    "defended",
    "escaped",
    "result"
  ],
  "$defs": {
    "attack": {
      "type": "object",
      "required": [
        "attackId",
        "description",
        "target",
        "mutation",
        "expectedDefense",
        "observed",
        "result",
        "evidence",
        "mandatory"
      ],
      "properties": {
        "attackId": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "mutation": {
          "type": "string",
          "minLength": 1
        },
        "expectedDefense": {
          "type": "string",
          "minLength": 1
        },
        "observed": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "DEFENDED",
            "ESCAPED",
            "NOT_EXECUTED"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "mandatory": {
          "type": "boolean"
        },
        "origin": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "baselineControl": {
      "type": "object",
      "required": [
        "result",
        "detail"
      ],
      "properties": {
        "result": {
          "enum": [
            "VALID",
            "INVALID"
          ]
        },
        "detail": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0",
        "1.1.0"
      ]
    },
    "checkpoint": {
      "type": "string",
      "minLength": 1
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "targetFingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "baselineControl": {
      "$ref": "#/$defs/baselineControl"
    },
    "attacks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/attack"
      }
    },
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "defended": {
      "type": "integer",
      "minimum": 0
    },
    "escaped": {
      "type": "integer",
      "minimum": 0
    },
    "mandatoryTotal": {
      "type": "integer",
      "minimum": 0
    },
    "mandatoryDefended": {
      "type": "integer",
      "minimum": 0
    },
    "result": {
      "enum": [
        "RED_TEAM_PASS",
        "RED_TEAM_FAIL"
      ]
    }
  },
  "additionalProperties": false,
  "description": "An executed adversarial battery. baselineControl records the null-mutation control: the unmutated fixture run through the identical path, which must be accepted before any attack is believed. The CP-0009 audit's first harness reported every attack as defended while the rejections came from leftover state rather than from the mutation under test, and only a null-mutation control exposed it. Sealed reports are validated against the schema of their own tree, so requiring it here constrains new reports only. The control is required from version 1.1.0 onwards and is validated by validate_checkpoint._validate_internal_assurance, so a report sealed under 1.0.0 keeps the rules it was written for."
}
