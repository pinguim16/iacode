{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/functional-acceptance.schema.json",
  "title": "IACode functional acceptance",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "gate", "checkpoint", "status", "generatedAt", "scenarios"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "gate": {"type": "string", "pattern": "^GATE-[0-9]+$"},
    "checkpoint": {"type": "string", "pattern": "^GATE-[0-9]+-CP-[0-9]{4}$"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED"]},
    "generatedAt": {"type": "string", "format": "date-time"},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId",
        "requirementIds",
        "feature",
        "scenario",
        "environment",
        "preconditions",
        "execution",
        "expected",
        "observed",
        "result",
        "evidence",
        "timestamp",
        "artifactReferences"
      ],
      "properties": {
        "scenarioId": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{2,63}$"},
        "requirementIds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^GATE-[0-9]+-[0-9]+\\.[0-9]+$"}
        },
        "feature": {"type": "string", "minLength": 1, "maxLength": 256},
        "scenario": {"type": "string", "minLength": 1, "maxLength": 1024},
        "environment": {"type": "string", "minLength": 1, "maxLength": 512},
        "preconditions": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        },
        "execution": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "expected": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "observed": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "result": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_APPLICABLE"]},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "timestamp": {"type": "string", "format": "date-time"},
        "artifactReferences": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/reference"}
        },
        "justification": {"type": ["string", "null"], "maxLength": 2048}
      },
      "allOf": [
        {
          "if": {"properties": {"result": {"const": "NOT_APPLICABLE"}}},
          "then": {"required": ["justification"], "properties": {"justification": {"type": "string", "minLength": 1}}}
        }
      ]
    }
  }
}
