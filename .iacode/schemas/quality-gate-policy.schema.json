{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/quality-gate-policy.schema.json",
  "title": "Mandatory quality gate registry",
  "type": "object",
  "required": [
    "schemaVersion",
    "policy",
    "gates"
  ],
  "$defs": {
    "gate": {
      "type": "object",
      "required": [
        "id",
        "title",
        "command",
        "purpose",
        "mandatory"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z][A-Za-z0-9]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "mandatory": {
          "type": "boolean"
        },
        "qualityDimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0"
      ]
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/gate"
      }
    }
  },
  "additionalProperties": false
}
