{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iacode.local/schemas/external-audit-attestation.schema.json",
  "title": "Independent audit attestation",
  "description": "Written by the audit checkpoint about the sealed subject checkpoint it judged. It never names its own commit, because an attestation that had to contain the commit of the tree that contains it would be unreachable, which is finding CP9-F-001.",
  "type": "object",
  "required": [
    "schemaVersion",
    "auditId",
    "milestone",
    "validationMechanism",
    "crossToolValidation",
    "auditorRole",
    "tool",
    "provider",
    "model",
    "freshSession",
    "subjectCheckpoint",
    "subjectCommit",
    "auditCheckpoint",
    "reviewResult",
    "redTeamResult",
    "completeness",
    "evidenceCoverage",
    "testResult",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": {
      "enum": [
        "2.0.0"
      ]
    },
    "auditId": {
      "type": "string",
      "minLength": 1
    },
    "milestone": {
      "type": "string",
      "pattern": "^M[0-9]+$"
    },
    "validationMechanism": {
      "enum": [
        "CROSS_TOOL_INDEPENDENT_AUDIT",
        "FRESH_SESSION_INDEPENDENT_AUDIT"
      ]
    },
    "crossToolValidation": {
      "enum": [
        "AVAILABLE",
        "NOT_AVAILABLE"
      ]
    },
    "auditorRole": {
      "type": "string",
      "minLength": 1
    },
    "tool": {
      "type": "string",
      "minLength": 1
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "freshSession": {
      "type": "boolean"
    },
    "subjectCheckpoint": {
      "type": "string",
      "minLength": 1
    },
    "subjectCommit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "auditCheckpoint": {
      "type": "string",
      "minLength": 1
    },
    "reviewResult": {
      "enum": [
        "APPROVED",
        "REWORK_REQUIRED"
      ]
    },
    "redTeamResult": {
      "enum": [
        "RED_TEAM_PASS",
        "RED_TEAM_FAIL"
      ]
    },
    "completeness": {
      "type": "number",
      "minimum": 0
    },
    "evidenceCoverage": {
      "type": "number",
      "minimum": 0
    },
    "testResult": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
